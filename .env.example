# Copy to .env and adjust, then: docker compose up -d

# Host port for the shared MCP endpoint (http://<host>:PORT/mcp)
ZREAD_MCP_PORT=8708

# Optional GitHub token: raises GitHub API rate limits and enables
# private repositories. Everything works without it on public repos.
GITHUB_TOKEN=

# Server-wide default language (zh / en)
ZREAD_LANG=en

# ---- AI Q&A backend (zread-ai service) ------------------------------------
# Host port for the RAG backend (http://<host>:PORT)
ZREAD_AI_PORT=8709

# Shared secret required on every /api/v1 request (server side).
# STRONGLY RECOMMENDED for any network-exposed deployment: without it anyone
# who can reach the backend can spend your GitHub API quota and LLM credits.
# The client must send the SAME value via ZREAD_AI_API_KEY (see README).
ZREAD_BACKEND_API_KEY=

# OpenAI-compatible LLM provider. See backend/.env.example for examples
# covering OpenAI, Azure, OpenRouter, and local Ollama / LiteLLM.
ZREAD_LLM_BASE_URL=https://api.openai.com/v1
ZREAD_LLM_API_KEY=
ZREAD_LLM_MODEL=gpt-4o-mini
ZREAD_EMBED_MODEL=text-embedding-3-small
ZREAD_EMBED_DIM=1536
