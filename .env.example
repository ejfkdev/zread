# Copy to .env and adjust, then: docker compose up -d

# Host port for the shared MCP endpoint (http://<host>:PORT/mcp)
ZREAD_MCP_PORT=8708

# zread.ai account token — enables the ask_ai tool for everyone
# connected to this server. Leave empty to run without AI Q&A.
ZREAD_TOKEN=

# 1 = direct mode: fetch everything from GitHub, never contact zread.ai
ZREAD_DIRECT=0

# Optional GitHub token for direct mode (higher API limits, private repos)
GITHUB_TOKEN=

# Server-wide defaults
ZREAD_LANG=en
ZREAD_MODEL=glm-5.1
# ZREAD_BASE_URL=https://zread.ai
