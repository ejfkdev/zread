# zread-ai-backend configuration.
# Copy to .env and adjust, then run: uvicorn app.main:app

# --- Server -----------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8709
# CORS_ORIGINS=*            # comma-separated, e.g. https://app.example.com,http://localhost:3000

# Shared secret required on every /api/v1 request (Authorization: Bearer).
# STRONGLY RECOMMENDED for any network-exposed deployment: without it anyone
# who can reach the backend can spend your GitHub API quota and LLM credits.
# Leave empty for local-only dev (the API is then open; a warning is logged).
BACKEND_API_KEY=

# --- GitHub (the backend fetches repos itself) ------------------------------
# Required for private repos and to raise API rate limits. Public repos work
# without a token (subject to GitHub's 60 req/hour anonymous limit).
GITHUB_TOKEN=

# --- OpenAI-compatible LLM / embeddings -------------------------------------
# Any OpenAI-compatible provider works. Examples:
#
# OpenAI:
#   ZREAD_LLM_BASE_URL=https://api.openai.com/v1
#   ZREAD_LLM_API_KEY=sk-...
#   ZREAD_LLM_MODEL=gpt-4o-mini
#   ZREAD_EMBED_MODEL=text-embedding-3-small
#   ZREAD_EMBED_DIM=1536
#
# Azure OpenAI (use the deployment endpoint + deployment names):
#   ZREAD_LLM_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/deployments/YOUR-DEPLOYMENT
#   ZREAD_LLM_API_KEY=...
#
# OpenRouter:
#   ZREAD_LLM_BASE_URL=https://openrouter.ai/api/v1
#   ZREAD_LLM_API_KEY=sk-or-...
#   ZREAD_LLM_MODEL=openai/gpt-4o-mini
#
# Local (Ollama or LiteLLM):
#   ZREAD_LLM_BASE_URL=http://localhost:11434/v1
#   ZREAD_LLM_API_KEY=ollama        # Ollama ignores the key but the field must be non-empty
#   ZREAD_LLM_MODEL=llama3.1
#   ZREAD_EMBED_MODEL=nomic-embed-text
#   ZREAD_EMBED_DIM=768
ZREAD_LLM_BASE_URL=https://api.openai.com/v1
ZREAD_LLM_API_KEY=
ZREAD_LLM_MODEL=gpt-4o-mini
ZREAD_EMBED_MODEL=text-embedding-3-small
ZREAD_EMBED_DIM=1536

# --- Indexing tuning --------------------------------------------------------
# CHUNK_MAX_TOKENS=800
# CHUNK_OVERLAP_TOKENS=100
# INDEX_MAX_FILES=2000
# INDEX_MAX_FILE_BYTES=524288
# RETRIEVAL_TOP_K=8
